{
    "name": "@npmegar/tequio",
    "version": "0.5.0",
    "description": "Live participation graph: projects at the center, people around, links as thick as the work. TV and print.",
    "keywords": [
        "graph",
        "force-directed",
        "network",
        "participation",
        "dashboard",
        "tv",
        "svg",
        "headless",
        "react"
    ],
    "homepage": "https://ghegar.github.io/tequio/",
    "bugs": {
        "url": "https://github.com/GHEgar/tequio/issues"
    },
    "license": "AGPL-3.0-only",
    "author": "Edgar Villarreal",
    "type": "module",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GHEgar/tequio.git"
    },
    "bin": {
        "tequio": "dist/cli/index.js"
    },
    "files": [
        "dist",
        "schema.json"
    ],
    "exports": {
        ".": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        },
        "./schema.json": "./schema.json",
        "./element": {
            "types": "./dist/element/index.d.ts",
            "import": "./dist/element/index.js"
        },
        "./standalone": "./dist/standalone/tequio-graph.js"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build --config vite.standalone.config.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "demo": "vite --config demo/vite.config.ts",
        "demo:build": "vite build --config demo/vite.config.ts",
        "e2e": "playwright test"
    },
    "peerDependencies": {
        "react": ">=19",
        "@resvg/resvg-js": ">=2.6",
        "react-dom": ">=19"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "@resvg/resvg-js": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "devDependencies": {
        "@npmegar/eslint-config": "^0.4.0",
        "@playwright/test": "^1.64.1",
        "@resvg/resvg-js": "^2.6.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.12.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "happy-dom": "^20.14.5",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "rotulo": "^0.3.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    },
    "overrides": {
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
