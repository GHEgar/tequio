{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://unpkg.com/@npmegar/tequio/schema.json",
    "title": "tequio GraphData",
    "description": "Projects, people and the work that links them, as drawn by tequio.",
    "type": "object",
    "required": ["projects", "people", "links"],
    "properties": {
        "statuses": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["key", "label"],
                "properties": {
                    "key": { "type": "string", "minLength": 1 },
                    "label": { "type": "string" },
                    "tone": { "enum": ["good", "warning", "serious", "critical", "neutral"] },
                    "color": { "type": "string" }
                }
            }
        },
        "projects": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "name", "progress"],
                "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "details": { "$ref": "#/$defs/details" },
                    "logo": { "type": "string" },
                    "color": { "type": "string" },
                    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
                    "counts": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
                }
            }
        },
        "people": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "details": { "$ref": "#/$defs/details" },
                    "avatar": { "type": "string" },
                    "color": { "type": "string" },
                    "metric": { "type": "number" },
                    "active": { "type": "boolean" }
                }
            }
        },
        "links": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["person", "project", "weight"],
                "properties": {
                    "person": { "type": "string" },
                    "project": { "type": "string" },
                    "weight": { "type": "number", "exclusiveMinimum": 0 }
                }
            }
        }
    },
    "$defs": {
        "details": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["label", "value"],
                "properties": {
                    "label": { "type": "string" },
                    "value": { "type": ["string", "number"] },
                    "href": { "type": "string" }
                }
            }
        }
    }
}
